# GCP Configuration
GCP_PROJECT_ID_STAGE=dfh-stage-id
GCP_PROJECT_ID_PROD=dfh-prod-id
GCP_REGION=us-central1

# Temporal Configuration
# Self-hosted Temporal on Cloud Run — workers connect over VPC connector.
# Cloud Run terminates TLS at port 443; use port 443 with TLS (no client cert).
TEMPORAL_ADDRESS=temporal-server.stage.internal:443
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=vertex-finetune-stage
# For production:
# TEMPORAL_ADDRESS=temporal-server.prod.internal:443
# TEMPORAL_TASK_QUEUE=vertex-finetune-prod

# HuggingFace
HF_TOKEN=<your-hf-token>

# Weights & Biases (optional)
WANDB_API_KEY=<your-wandb-key>
WANDB_PROJECT=llm-fine-tuning

# GCS Buckets (set by Terraform)
GCS_RAW_DOCUMENTS_BUCKET=
GCS_PROCESSED_DATASETS_BUCKET=
GCS_CHECKPOINTS_BUCKET=
GCS_FINAL_MODELS_BUCKET=
GCS_BUILD_ARTIFACTS_BUCKET=

# Vertex AI
VERTEX_AI_REGION=us-central1
VERTEX_AI_STAGING_BUCKET=
