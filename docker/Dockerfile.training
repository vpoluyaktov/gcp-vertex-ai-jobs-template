# syntax=docker/dockerfile:1.7
###############################################################################
# Vertex AI training container — CPU-only.
#
# Purpose: smoke testing of the training entrypoint glue (config loading,
# dataset construction, callbacks) without needing a GPU. Real training jobs
# always use Dockerfile.training.gpu — this image deliberately omits unsloth,
# bitsandbytes, and flash-attn (all CUDA-only).
#
# Use this image for:
#   - CI integration tests of training/utils/
#   - Local `python -m training.train` smoke runs with tiny models
#   - Validating Hydra config parsing
#
# Do NOT use this image for real fine-tuning runs.
###############################################################################

FROM python:3.11-slim-bookworm AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# CPU-only torch index — saves several GB vs. the default CUDA build.
RUN pip install --upgrade pip wheel setuptools \
    && pip install \
        --index-url https://download.pytorch.org/whl/cpu \
        --extra-index-url https://pypi.org/simple \
        torch>=2.4.0 \
    && pip install \
        transformers>=4.46.0,\<4.55.0 \
        peft>=0.13.0,\<1 \
        trl>=0.12.0,\<1 \
        datasets>=3.0.0,\<4 \
        accelerate>=1.0.0,\<2 \
        google-cloud-aiplatform>=1.71.0,\<2 \
        google-cloud-storage>=2.16.0,\<3 \
        hydra-core>=1.3.0,\<1.4 \
        omegaconf>=2.3.0,\<3 \
        pydantic>=2.0.0,\<3 \
        PyYAML>=6.0

ARG TRAINER_UID=1000
RUN groupadd --system --gid ${TRAINER_UID} trainer \
    && useradd --system --uid ${TRAINER_UID} --gid trainer --create-home --shell /bin/bash trainer

WORKDIR /workspace
COPY --chown=trainer:trainer training/ /workspace/training/

USER trainer

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace \
    HF_HOME=/workspace/.cache/huggingface \
    TRANSFORMERS_CACHE=/workspace/.cache/huggingface/transformers

ENTRYPOINT ["python", "-m", "training.train"]
